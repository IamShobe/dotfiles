<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.elranshefer.free-disk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>log=$HOME/Library/Logs/free-disk.log; [ -f $log ] &amp;&amp; tail -n 2000 $log &gt; $log.tmp &amp;&amp; mv $log.tmp $log; $HOME/.claude/skills/free-disk/scripts/free-disk --apply --if-below 40 &gt;&gt; $log 2&gt;&amp;1</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/elranshefer/.local/share/mise/shims:/Users/elranshefer/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
