{{- /* Only generic settings belong here. Local providers never enter the source tree.

  Optional, in providers.local.json:
    "same_model_fallbacks": {"anthropic": ["github-copilot"], "vertex": ["github-copilot"]}
    "claude_secondary_fallbacks": {"claude-opus-": ["azure/some-model"]}
    "anthropic_model_aliases": {"canonical-model-id": ["legacy-model-id"]}
    "model_discovery": {"vertex": {"include": ["gemini-4-*"]}}   catalog filter for bifrost-model-refresh
  Model lists of discoverable keys come from ~/.local/state/bifrost/discovered-models.json
  (written by bifrost-model-refresh) when present; aliases set here win over discovered ones.
    "subscription_fallbacks": ["azure/some-model"]   provider/model entries ("provider/" keeps the model)
  When the subscription refuses a request at its usage limit (HTTP 429, which it returns once
  extra usage is turned off in Claude's settings), Bifrost retries it on these providers with
  their own keys. The setup script runs bifrost-fallback-check and removes the fallbacks again
  if any of them would receive Claude Code's sign-in.
*/ -}}
{{- $claudeRule := dict
  "id" "route-claude"
  "name" "Claude subscription"
  "enabled" true
  "scope" "global"
  "priority" 100
  "cel_expression" "model.startsWith('claude-')"
  "targets" (list (dict "provider" "anthropic" "weight" 1.0))
  "fallbacks" (list) -}}
{{- $config := dict
  "$schema" "https://www.getbifrost.ai/schema"
  "encryption_key" "env.BIFROST_ENCRYPTION_KEY"
  "setup_token" "env.BIFROST_SETUP_TOKEN"
  "client" (dict
    "disable_content_logging" true
    "enable_logging" true
    "log_retention_days" 7
    "logging_headers" (list)
    "allow_direct_keys" true
    "allowed_origins" (list "http://localhost:4001" "http://127.0.0.1:4001"))
  "governance" (dict
    "auth_config" (dict
      "is_enabled" true
      "admin_username" "admin"
      "admin_password" "env.BIFROST_ADMIN_PASSWORD"
      "disable_auth_on_inference" true)
    "routing_rules" (list $claudeRule))
  "providers" (dict "anthropic" (dict "keys" (list) "network_config" (dict "max_retries" 0)))
  "plugins" (list)
-}}
{{- $localPath := joinPath .chezmoi.homeDir ".config/bifrost/providers.local.json" -}}
{{- if stat $localPath -}}
  {{- $local := include $localPath | fromJson -}}
  {{- $localProviders := dig "providers" (dict) $local -}}
  {{- $discoveredPath := joinPath .chezmoi.homeDir ".local/state/bifrost/discovered-models.json" -}}
  {{- $discovered := dict -}}
  {{- if stat $discoveredPath -}}{{- $discovered = include $discoveredPath | fromJson | dig "providers" (dict) -}}{{- end -}}
  {{- range $name, $provider := $localProviders -}}
    {{- if eq $name "anthropic" -}}
      {{- fail "Local providers cannot override the generic Anthropic subscription route" -}}
    {{- end -}}
    {{- range $key := $provider.keys -}}
      {{- $found := dig $name $key.name (dict) $discovered -}}
      {{- if $found -}}
        {{- $_ := set $key "models" $found.models -}}
        {{- $aliases := merge (dig "aliases" (dict) $key) (dig "aliases" (dict) $found) -}}
        {{- if $aliases -}}{{- $_ := set $key "aliases" $aliases -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $_ := set $config.providers $name $provider -}}
  {{- end -}}
  {{- $fallbacks := dig "subscription_fallbacks" (list) $local -}}
  {{- $tierRules := list -}}
  {{- if kindIs "map" $fallbacks -}}
    {{- $priority := 90 -}}
    {{- range $prefix := keys $fallbacks | sortAlpha -}}
      {{- $entries := index $fallbacks $prefix -}}
      {{- range $fallback := $entries -}}
        {{- $provider := index (splitList "/" $fallback) 0 -}}
        {{- if eq $provider "anthropic" -}}
          {{- fail "subscription_fallbacks cannot point back at the subscription provider \"anthropic\"" -}}
        {{- end -}}
        {{- if not (hasKey $localProviders $provider) -}}
          {{- fail (printf "subscription_fallbacks entry %q names a provider not defined in providers.local.json" $fallback) -}}
        {{- end -}}
      {{- end -}}
      {{- if eq $prefix "default" -}}
        {{- $_ := set $claudeRule "fallbacks" $entries -}}
      {{- else -}}
        {{- $slug := trimSuffix "-" $prefix -}}
        {{- $tierRules = append $tierRules (dict
          "id" (printf "route-%s" $slug)
          "name" (printf "Claude subscription (%s)" $slug)
          "enabled" true
          "scope" "global"
          "priority" $priority
          "cel_expression" (printf "model.startsWith('%s')" $prefix)
          "targets" (list (dict "provider" "anthropic" "weight" 1.0))
          "fallbacks" $entries) -}}
        {{- $priority = add $priority 1 -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- range $fallback := $fallbacks -}}
      {{- $provider := index (splitList "/" $fallback) 0 -}}
      {{- if eq $provider "anthropic" -}}
        {{- fail "subscription_fallbacks cannot point back at the subscription provider \"anthropic\"" -}}
      {{- end -}}
      {{- if not (hasKey $localProviders $provider) -}}
        {{- fail (printf "subscription_fallbacks entry %q names a provider not defined in providers.local.json" $fallback) -}}
      {{- end -}}
    {{- end -}}
    {{- $_ := set $claudeRule "fallbacks" $fallbacks -}}
  {{- end -}}
  {{- $localRules := dig "routing_rules" (list) $local -}}
  {{- $sameModelRules := list -}}
  {{- $sameModelPolicies := dig "same_model_fallbacks" (dict) $local -}}
  {{- $priority := 75 -}}
  {{- range $primary := keys $sameModelPolicies | sortAlpha -}}
    {{- if not (hasKey $config.providers $primary) -}}{{- fail (printf "same_model_fallbacks primary provider %q is not configured" $primary) -}}{{- end -}}
    {{- $primaryModels := list -}}
    {{- range $key := (index $config.providers $primary).keys -}}
      {{- range $model := $key.models -}}
        {{- if ne $model "*" -}}{{- $primaryModels = append $primaryModels $model -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if ne (len (index $sameModelPolicies $primary)) 1 -}}{{- fail "same_model_fallbacks requires exactly one same-model backup per primary provider" -}}{{- end -}}
    {{- range $backup := index $sameModelPolicies $primary -}}
      {{- if or (eq $primary $backup) (hasKey $sameModelPolicies $backup) -}}{{- fail "same_model_fallbacks must not contain loops or chained provider policies" -}}{{- end -}}
      {{- if not (hasKey $localProviders $backup) -}}{{- fail (printf "same_model_fallbacks backup provider %q is not configured" $backup) -}}{{- end -}}
      {{- $backupModels := list -}}
      {{- range $key := (index $localProviders $backup).keys -}}
        {{- range $model := $key.models -}}{{- $backupModels = append $backupModels $model -}}{{- end -}}
      {{- end -}}
      {{- if eq $primary "anthropic" -}}
        {{- $claudePriority := 80 -}}
        {{- $secondaryByFamily := dig "claude_secondary_fallbacks" (dict) $local -}}
        {{- $modelAliases := dig "anthropic_model_aliases" (dict) $local -}}
        {{- range $copilotModel := $backupModels | uniq | sortAlpha -}}
          {{- if regexMatch "^claude-[a-z]+-[0-9]+([.][0-9]+)?$" $copilotModel -}}
            {{- $sourceModel := replace "." "-" $copilotModel -}}
            {{- $family := regexFind "^claude-[a-z]+-" $copilotModel -}}
            {{- $version := regexFind "[0-9]+([.][0-9]+)?$" $copilotModel -}}
            {{- $id := printf "route-%s%s" $family (replace "." "" $version) -}}
            {{- $sourceNames := prepend (dig $sourceModel (list) $modelAliases) $sourceModel -}}
            {{- $secondary := dig $family (list) $secondaryByFamily -}}
            {{- range $entry := $secondary -}}
              {{- $provider := index (splitList "/" $entry) 0 -}}
              {{- if or (eq $provider "anthropic") (eq $provider $backup) (not (hasKey $localProviders $provider)) -}}
                {{- fail (printf "Invalid Claude secondary fallback %q" $entry) -}}
              {{- end -}}
            {{- end -}}
            {{- if ge $claudePriority 100 -}}{{- fail "Too many Claude fallback rules for the reserved priority range" -}}{{- end -}}
            {{- $sameModelRules = append $sameModelRules (dict
              "id" $id "name" (printf "Same-model fallback: anthropic to %s (%s)" $backup $copilotModel)
              "enabled" true "scope" "global" "priority" $claudePriority
              "cel_expression" (printf "provider != '%s' && model in %s" $backup (toJson $sourceNames))
              "targets" (list (dict "provider" "anthropic" "weight" 1.0))
              "fallbacks" (concat (list (printf "%s/%s" $backup $copilotModel)) $secondary)) -}}
            {{- $claudePriority = add $claudePriority 1 -}}
          {{- end -}}
        {{- end -}}
      {{- else -}}
      {{- $sharedModels := list -}}
      {{- range $model := $primaryModels | uniq | sortAlpha -}}
        {{- if has $model $backupModels -}}{{- $sharedModels = append $sharedModels $model -}}{{- end -}}
      {{- end -}}
      {{- if $sharedModels -}}
        {{- $sameModelRules = append $sameModelRules (dict
          "id" (printf "route-auto-%s-%s" $primary $backup)
          "name" (printf "Same-model fallback: %s to %s" $primary $backup)
          "enabled" true "scope" "global" "priority" $priority
          "cel_expression" (printf "provider != '%s' && model in %s" $backup (toJson $sharedModels))
          "targets" (list (dict "provider" $primary "weight" 1.0))
          "fallbacks" (list (printf "%s/" $backup))) -}}
        {{- $priority = add $priority 1 -}}
      {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $backups := list -}}
  {{- range $primary, $entries := $sameModelPolicies -}}{{- $backups = concat $backups $entries -}}{{- end -}}
  {{- $serveRules := list -}}
  {{- $servePriority := 90 -}}
  {{- range $name := keys $localProviders | sortAlpha -}}
    {{- if not (has $name $backups) -}}
      {{- $served := list -}}
      {{- range $key := (index $localProviders $name).keys -}}
        {{- range $model := $key.models -}}{{- if ne $model "*" -}}{{- $served = append $served $model -}}{{- end -}}{{- end -}}
      {{- end -}}
      {{- if $served -}}
        {{- $serveRules = append $serveRules (dict
          "id" (printf "route-serve-%s" $name)
          "name" (printf "Models served by %s" $name)
          "enabled" true "scope" "global" "priority" $servePriority
          "cel_expression" (printf "model in %s" ($served | uniq | sortAlpha | toJson))
          "targets" (list (dict "provider" $name "weight" 1.0))
          "fallbacks" (list)) -}}
        {{- $servePriority = add $servePriority 1 -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $allRules := concat $localRules $tierRules $sameModelRules $serveRules (list $claudeRule) -}}
  {{- $_ := set $config.governance "routing_rules" $allRules -}}
{{- end -}}
{{ toPrettyJson $config }}
