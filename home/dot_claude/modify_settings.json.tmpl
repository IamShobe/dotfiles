#!/usr/bin/env python3
"""Merge chezmoi-managed Claude settings into the existing file on this machine.

chezmoi pipes the current ~/.claude/settings.json in on stdin and takes the desired
contents from stdout. Merging (rather than replacing) keeps machine-local state that
no other machine should carry:

  - BlueBear's `bluebear hook claude …` hooks — installed and reconciled by the local
    BlueBear daemon, which is not present on every machine.
  - `model` — chosen per machine.
  - `modelPicker` — /model rows, generated from the local gateway's providers
    (~/.config/bifrost/providers.local.json) so a new gateway model shows up on the next
    apply; rows added by hand for other models are kept.
  - `enabledPlugins` / `extraKnownMarketplaces` entries this template doesn't name —
    plugins another manager installed here (skillshare owns diagram-design). Entries
    named here still win.

Anything else in this template is authoritative and overwrites the local value.
"""

import json
import os
import sys
import urllib.request

MANAGED = json.loads(r"""
{
  "env": {
    "NODE_OPTIONS": "--require {{ .chezmoi.homeDir }}/.claude/hooks/tsc-limit.cjs",
    "TSC_MAX_PARALLEL": "3"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "UserPromptSubmit": [],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.config/herdr-app/mods/chat/session-note.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.config/herdr-app/mods/chat/ask-hook.sh'",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/prefer-rg.sh'"
          },
          {
            "type": "command",
            "command": "/opt/homebrew/bin/rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/skills/no-smell/scripts/hook.sh'",
            "timeout": 15,
            "statusMessage": "no-smell scan"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/status.py"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "effortLevel": "medium",
  "alwaysThinkingEnabled": false,
  "showThinkingSummaries": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "claude-api@anthropic-agent-skills": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  }
}
""")

# Keys left to whatever the machine already has.
LOCAL_ONLY_KEYS = ("model", "advisorModel", "modelPicker", "sshConfigs", "modelSettings")  # per machine: model and /advisor choice, workplace models, SSH hosts, /autocompact choices
# Gateway rows say [1m], so Claude Code assumes a 1,000,000-token window. A model whose real
# window is smaller would fail before auto-compaction starts, so it gets a per-model compaction
# window from the gateway's model datasheet (or "context_window" in model_picker).
ASSUMED_WINDOW = 1_000_000
GATEWAY_MODELS_URL = "http://127.0.0.1:{port}/v1/models".format(port=os.environ.get("CLAUDE_BIFROST_PORT", "4001"))
GATEWAY_TIMEOUT_SECONDS = 2
# The local Bifrost gateway's providers (machine-local, never in this repo). Every model they
# serve gets a /model row; optional "model_picker": {"<model>": {"label", "description",
# "model"}} in the same file overrides a generated row.
GATEWAY_PROVIDERS = os.path.expanduser("~/.config/bifrost/providers.local.json")
DISCOVERED_MODELS = os.path.expanduser("~/.local/state/bifrost/discovered-models.json")
GENERATED_PICKER_MODELS = os.path.expanduser("~/.local/state/bifrost/picker-models.json")
GENERATED_COMPACTION_WINDOWS = os.path.expanduser("~/.local/state/bifrost/compaction-windows.json")
PROVIDER_NAMES = {"azure": "Azure Foundry", "vertex": "Google Vertex", "bedrock": "AWS Bedrock", "openai": "OpenAI"}
UPPERCASE_WORDS = {"gpt"}
SOURCE_WORDS = {"deployments": "direct", "router": "via router"}
# Keys merged entry by entry: the machine's entries survive, the template's win.
MERGED_KEYS = ("enabledPlugins", "extraKnownMarketplaces")


def is_local_hook(command):
    return "bluebear" in command


def main():
    raw = sys.stdin.read()
    try:
        current = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        # Never destroy a file we cannot parse.
        sys.stdout.write(raw)
        return

    result = dict(MANAGED)

    for key in LOCAL_ONLY_KEYS:
        if key in current:
            result[key] = current[key]

    picker = gateway_model_picker(current_picker=current.get("modelPicker", {}))
    if picker is not None:
        result["modelPicker"] = picker
        result["modelSettings"] = with_gateway_compaction_windows(current_settings=current.get("modelSettings", {}))

    for key in MERGED_KEYS:
        result[key] = merge_machine_entries(managed=MANAGED.get(key, {}), machine=current.get(key, {}))

    merged_hooks = {
        event: [dict(entry) for entry in entries]
        for event, entries in MANAGED.get("hooks", {}).items()
    }

    for event, entries in current.get("hooks", {}).items():
        for entry in entries:
            local = [hk for hk in entry.get("hooks", []) if is_local_hook(hk.get("command", ""))]
            if not local:
                continue
            preserved = dict(entry)
            preserved["hooks"] = local
            merged_hooks.setdefault(event, []).append(preserved)

    result["hooks"] = merged_hooks
    json.dump(result, sys.stdout, indent=2)
    sys.stdout.write("\n")


def merge_machine_entries(*, managed, machine):
    """Entries only this machine has stay; entries the template names take its value."""
    return {**machine, **managed}


def gateway_model_picker(*, current_picker):
    """One /model row per gateway model, then any row added by hand for another model.

    None when this machine has no gateway providers file: the picker stays as it is.
    """
    gateway = read_gateway_providers()
    if gateway is None:
        return None
    overrides = gateway.get("model_picker", {})
    favorites = read_discovered_models().get("favorites", {})
    labels = discovered_by_model(field="labels")
    sources = discovered_sources()
    windows = known_context_windows(overrides=overrides)
    rows = [
        favorite_row(family=family, target=target, override=overrides.get(family, {}), window=windows.get(target["model"]))
        for family, target in favorites.items()
    ] + [
        picker_row(
            provider=provider, model=model, override=overrides.get(model, {}), label=labels.get(model),
            source=sources.get(provider, {}).get(model), window=windows.get(model),
        )
        for provider, model in gateway_models(gateway=gateway)
    ]
    served = {model for _, model in gateway_models(gateway=gateway)} | set(favorites)
    generated_before = read_generated_picker_models()
    by_hand = [
        row for row in current_picker.get("options", [])
        if base_model(row.get("model", "")) not in served | generated_before
    ]
    remember_generated_picker_models(models=served | generated_before)
    return {**current_picker, "options": rows + by_hand}


def read_generated_picker_models():
    """Every model this script has listed, so a model the gateway stopped serving loses its row."""
    return set(read_state(path=GENERATED_PICKER_MODELS, empty=[]))


def remember_generated_picker_models(*, models):
    write_state(path=GENERATED_PICKER_MODELS, value=sorted(models))


def read_state(*, path, empty):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError):
        return empty


def write_state(*, path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = f"{path}.tmp"
    with open(temporary, "w") as handle:
        json.dump(value, handle)
    os.replace(temporary, path)


def with_gateway_compaction_windows(*, current_settings):
    """autoCompactWindow for gateway models smaller than the assumed 1M.

    Sources, strongest first: "context_window" in model_picker, the provider's own model list
    (discovered), the gateway datasheet. A value this script did not write is left as set by hand.
    """
    gateway = read_gateway_providers() or {}
    overrides = gateway.get("model_picker", {})
    datasheet = gateway_context_windows()
    known = {**datasheet, **discovered_by_model(field="context_windows")}
    targets = {family: target["model"] for family, target in read_discovered_models().get("favorites", {}).items()}
    written_before = read_state(path=GENERATED_COMPACTION_WINDOWS, empty={})
    settings = {model: dict(values) for model, values in current_settings.items()}
    written = {}
    for model in [model for _, model in gateway_models(gateway=gateway)] + list(targets):
        window = overrides.get(model, {}).get("context_window") or known.get(targets.get(model, model))
        if not window or window >= ASSUMED_WINDOW:
            continue
        name = f"{model}[1m]"
        entry = settings.setdefault(name, {})
        if entry.get("autoCompactWindow") in (None, written_before.get(name), datasheet.get(model)):
            entry["autoCompactWindow"] = window
            written[name] = window
    write_state(path=GENERATED_COMPACTION_WINDOWS, value={**written_before, **written})
    return settings


def gateway_context_windows():
    """model → context window from the running gateway's datasheet; empty when it is not running."""
    try:
        with urllib.request.urlopen(GATEWAY_MODELS_URL, timeout=GATEWAY_TIMEOUT_SECONDS) as response:
            listing = json.load(response)
    except (OSError, json.JSONDecodeError):
        return {}
    windows = {}
    for entry in listing.get("data", []):
        window = entry.get("context_length")
        if isinstance(window, int):
            windows[entry.get("id", "").split("/", 1)[-1]] = window
    return windows


def read_gateway_providers():
    try:
        with open(GATEWAY_PROVIDERS) as handle:
            return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def gateway_models(*, gateway):
    """(provider, model) for every model a primary provider's key serves, in file order, each model once.

    Same-model backup providers are skipped: requests reach them only as fallbacks. Discovered
    model lists (bifrost-model-refresh) replace a key's configured list, as in the gateway config.
    """
    discovered = read_discovered_models().get("providers", {})
    backups = {backup for entries in gateway.get("same_model_fallbacks", {}).values() for backup in entries}
    seen = set()
    for provider, config in gateway.get("providers", {}).items():
        if provider in backups:
            continue
        for key in config.get("keys", []):
            found = discovered.get(provider, {}).get(key.get("name"), {})
            for model in found.get("models", key.get("models", [])):
                if model != "*" and model not in seen:
                    seen.add(model)
                    yield provider, model


def read_discovered_models():
    return read_state(path=DISCOVERED_MODELS, empty={})


def discovered_by_model(*, field):
    """model → value of a discovered per-key field ("labels", "context_windows") across all keys."""
    merged = {}
    for keys in read_discovered_models().get("providers", {}).values():
        for found in keys.values():
            merged.update(found.get(field, {}))
    return merged


def favorite_row(*, family, target, override, window):
    return {
        "model": override.get("model", f"{family}[1m]"),
        "label": override.get("label", f"{family[:1].upper()}{family[1:]} · latest"),
        "description": override.get(
            "description",
            " · ".join(filter(None, [
                f"Now {readable_model_name(target['model'])}",
                PROVIDER_NAMES.get(target["provider"], target["provider"]),
                context_text(window=window),
            ])),
        ),
    }


def picker_row(*, provider, model, override, label, source, window):
    """"Azure Foundry direct · 272K context": the provider, the path to it and the real window."""
    path = " ".join(filter(None, [PROVIDER_NAMES.get(provider, provider), SOURCE_WORDS.get(source)]))
    return {
        "model": override.get("model", f"{model}[1m]"),
        "label": override.get("label", label or readable_model_name(model)),
        "description": override.get("description", " · ".join(filter(None, [path, context_text(window=window)]))),
    }


def context_text(*, window):
    if not window:
        return None
    return "1M context" if window >= ASSUMED_WINDOW else f"{round(window / 1000)}K context"


def discovered_sources():
    """provider → model → how its key's models were found ("deployments", "router", "catalog")."""
    sources = {}
    for provider, keys in read_discovered_models().get("providers", {}).items():
        for found in keys.values():
            sources.setdefault(provider, {}).update({model: found.get("source") for model in found.get("models", [])})
    return sources


def known_context_windows(*, overrides):
    """Context window per model: "context_window" in model_picker, then the provider's list, then the gateway."""
    known = {**gateway_context_windows(), **discovered_by_model(field="context_windows")}
    return {**known, **{model: values["context_window"] for model, values in overrides.items() if "context_window" in values}}


def readable_model_name(model):
    """gemini-4-neon → Gemini 4 Neon, gpt-6.1-sol → GPT-6.1 Sol."""
    words = model.split("-")
    parts = []
    for word in words:
        if parts and parts[-1].lower() in UPPERCASE_WORDS and word[:1].isdigit():
            parts[-1] = f"{parts[-1]}-{word}"
        else:
            parts.append(word.upper() if word in UPPERCASE_WORDS else word[:1].upper() + word[1:])
    return " ".join(parts)


def base_model(model):
    """The model id without Claude Code's context suffix: gpt-5.5[1m] → gpt-5.5."""
    return model.split("[", 1)[0]


main()
