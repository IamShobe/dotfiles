#!/usr/bin/env python3
"""Merge chezmoi-managed Claude settings into the existing file on this machine.

chezmoi pipes the current ~/.claude/settings.json in on stdin and takes the desired
contents from stdout. Merging (rather than replacing) keeps machine-local state that
no other machine should carry:

  - BlueBear's `bluebear hook claude …` hooks — installed and reconciled by the local
    BlueBear daemon, which is not present on every machine.
  - `model` — chosen per machine.
  - `modelPicker` — extra /model rows for machine-local gateway models (workplace).
  - `enabledPlugins` / `extraKnownMarketplaces` entries this template doesn't name —
    plugins another manager installed here (skillshare owns diagram-design). Entries
    named here still win.

Anything else in this template is authoritative and overwrites the local value.
"""

import json
import sys

MANAGED = json.loads(r"""
{
  "env": {
    "NODE_OPTIONS": "--require {{ .chezmoi.homeDir }}/.claude/hooks/tsc-limit.cjs",
    "TSC_MAX_PARALLEL": "3"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "UserPromptSubmit": [],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.config/herdr-app/mods/chat/session-note.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '{{ .chezmoi.homeDir }}/.config/herdr-app/mods/chat/ask-hook.sh'",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/skills/no-smell/scripts/hook.sh'",
            "timeout": 15,
            "statusMessage": "no-smell scan"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 {{ .chezmoi.homeDir }}/.claude/hooks/status.py"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "effortLevel": "medium",
  "alwaysThinkingEnabled": false,
  "showThinkingSummaries": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "claude-api@anthropic-agent-skills": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  }
}
""")

# Keys left to whatever the machine already has.
LOCAL_ONLY_KEYS = ("model", "modelPicker")  # modelPicker: workplace models, per machine
# Keys merged entry by entry: the machine's entries survive, the template's win.
MERGED_KEYS = ("enabledPlugins", "extraKnownMarketplaces")


def is_local_hook(command):
    return "bluebear" in command


def main():
    raw = sys.stdin.read()
    try:
        current = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        # Never destroy a file we cannot parse.
        sys.stdout.write(raw)
        return

    result = dict(MANAGED)

    for key in LOCAL_ONLY_KEYS:
        if key in current:
            result[key] = current[key]

    for key in MERGED_KEYS:
        result[key] = merge_machine_entries(managed=MANAGED.get(key, {}), machine=current.get(key, {}))

    merged_hooks = {
        event: [dict(entry) for entry in entries]
        for event, entries in MANAGED.get("hooks", {}).items()
    }

    for event, entries in current.get("hooks", {}).items():
        for entry in entries:
            local = [hk for hk in entry.get("hooks", []) if is_local_hook(hk.get("command", ""))]
            if not local:
                continue
            preserved = dict(entry)
            preserved["hooks"] = local
            merged_hooks.setdefault(event, []).append(preserved)

    result["hooks"] = merged_hooks
    json.dump(result, sys.stdout, indent=2)
    sys.stdout.write("\n")


def merge_machine_entries(*, managed, machine):
    """Entries only this machine has stay; entries the template names take its value."""
    return {**machine, **managed}


main()
