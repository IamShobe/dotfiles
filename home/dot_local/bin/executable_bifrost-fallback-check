#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pydantic>=2.7", "typer>=0.12"]
# ///
"""Prove that the local Bifrost gateway's subscription fallbacks never carry the Claude sign-in.

When the subscription refuses a request at its usage limit, Bifrost retries it on the fallbacks
listed on the `route-claude` rule. Some Bifrost versions forward the caller's own headers on that
retry, which would hand the Claude sign-in to another provider. This check runs the installed
bifrost on a spare port against stand-ins: a subscription that answers 429, and one recorder per
fallback. It passes only when every fallback is reached and none of them sees the sign-in.

    bifrost-fallback-check                 # check the live config
    bifrost-fallback-check --config FILE   # check another rendered config

Exit 0: safe (or no fallbacks configured). Exit 1: a fallback leaked, or could not be checked.
"""

import base64
import json
import os
import secrets
import socket
import subprocess
import tempfile
import threading
import time
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Annotated

import typer
from pydantic import BaseModel, ConfigDict, JsonValue, TypeAdapter

SUBSCRIPTION_RULE_ID = "route-claude"
SIGN_IN_TOKEN = "sk-ant-oat01-FALLBACK-CHECK-NOT-A-REAL-TOKEN"
SIGN_IN_MARKERS = ("sk-ant-oat", "oauth-2025")
FALLBACK_OWN_KEY = "fallback-check-own-key"
STARTUP_TIMEOUT_SECONDS = 30
REQUEST_TIMEOUT_SECONDS = 30
CLAUDE_CODE_HEADERS = {
    "content-type": "application/json",
    "anthropic-version": "2023-06-01",
    "authorization": f"Bearer {SIGN_IN_TOKEN}",
    "anthropic-beta": "oauth-2025-04-20",
    "user-agent": "claude-cli/2.1.326 (external, cli)",
}

app = typer.Typer(add_completion=False)


class RoutingRule(BaseModel):
    model_config = ConfigDict(extra="allow")
    id: str
    fallbacks: list[str] = []


class Governance(BaseModel):
    model_config = ConfigDict(extra="allow")
    routing_rules: list[RoutingRule] = []


class GatewayConfig(BaseModel):
    model_config = ConfigDict(extra="allow")
    governance: Governance
    providers: dict[str, dict[str, JsonValue]]


@dataclass
class Recording:
    """What one stand-in upstream received: one entry of header values per request."""

    requests: list[dict[str, str]] = field(default_factory=list)


@app.command()
def main(
    config: Annotated[Path, typer.Option(help="Rendered Bifrost config.json")] = Path.home() / ".config/bifrost/config.json",
    bifrost: Annotated[Path, typer.Option(help="Bifrost binary")] = Path.home() / ".local/bin/bifrost",
) -> None:
    gateway_config = GatewayConfig.model_validate_json(config.read_text())
    fallbacks = subscription_fallbacks(gateway_config=gateway_config)
    if not fallbacks:
        print("bifrost-fallback-check: no subscription fallbacks configured; nothing to check")
        return
    problems = check_fallbacks(gateway_config=gateway_config, fallbacks=fallbacks, bifrost=bifrost)
    for problem in problems:
        print(f"✗ {problem}")
    if problems:
        print("bifrost-fallback-check: UNSAFE — do not enable these fallbacks with this Bifrost version")
        raise typer.Exit(1)
    print(f"✓ bifrost-fallback-check: {len(fallbacks)} fallback(s) received only their own key")


def subscription_fallbacks(*, gateway_config: GatewayConfig) -> list[str]:
    """One representative fallback entry per provider across every route-claude* rule."""
    chosen: list[str] = []
    seen_providers: set[str] = set()
    for rule in gateway_config.governance.routing_rules:
        if rule.id != SUBSCRIPTION_RULE_ID and not rule.id.startswith(f"{SUBSCRIPTION_RULE_ID}-"):
            continue
        for entry in rule.fallbacks:
            provider = entry.partition("/")[0]
            if provider not in seen_providers:
                seen_providers.add(provider)
                chosen.append(entry)
    return chosen


def check_fallbacks(*, gateway_config: GatewayConfig, fallbacks: list[str], bifrost: Path) -> list[str]:
    subscription = start_recorder(answers="limit")
    stand_ins = {entry: start_recorder(answers="limit" if index < len(fallbacks) - 1 else "ok") for index, entry in enumerate(fallbacks)}
    try:
        test_config, unsupported = build_test_config(
            gateway_config=gateway_config, subscription_url=subscription.url, stand_ins={k: v.url for k, v in stand_ins.items()}
        )
        if unsupported:
            return unsupported
        send_claude_code_request(config=test_config, bifrost=bifrost)
    finally:
        for recorder in [subscription, *stand_ins.values()]:
            recorder.server.shutdown()
    return judge(subscription=subscription.recording, stand_ins={k: v.recording for k, v in stand_ins.items()})


@dataclass
class Recorder:
    server: ThreadingHTTPServer
    url: str
    recording: Recording


def start_recorder(*, answers: str) -> Recorder:
    recording = Recording()
    handler = make_handler(recording=recording, answers=answers)
    server = ThreadingHTTPServer(("127.0.0.1", 0), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return Recorder(server=server, url=f"http://127.0.0.1:{server.server_address[1]}", recording=recording)


def make_handler(*, recording: Recording, answers: str) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        def do_POST(self) -> None:
            self.rfile.read(int(self.headers.get("content-length", 0)))
            recording.requests.append({key.lower(): value for key, value in self.headers.items()})
            if answers == "limit":
                self.reply(status=429, payload={"type": "error", "error": {"type": "rate_limit_error", "message": "usage limit reached"}})
            else:
                self.reply(status=200, payload=success_reply(path=self.path))

        def do_GET(self) -> None:
            self.reply(status=200, payload={"data": [], "object": "list", "has_more": False})

        def reply(self, *, status: int, payload: dict[str, JsonValue]) -> None:
            data = json.dumps(payload).encode()
            self.send_response(status)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, *_: object) -> None:
            pass

    return Handler


def success_reply(*, path: str) -> dict[str, JsonValue]:
    text = "answered by the fallback stand-in"
    if path.endswith("/responses"):
        return {
            "id": "resp_check", "object": "response", "created_at": 0, "status": "completed", "model": "check",
            "output": [{"type": "message", "id": "msg_check", "status": "completed", "role": "assistant",
                        "content": [{"type": "output_text", "text": text, "annotations": []}]}],
            "usage": {"input_tokens": 1, "output_tokens": 1, "total_tokens": 2},
        }
    if path.endswith("/messages"):
        return {
            "id": "msg_check", "type": "message", "role": "assistant", "model": "check",
            "content": [{"type": "text", "text": text}], "stop_reason": "end_turn", "stop_sequence": None,
            "usage": {"input_tokens": 1, "output_tokens": 1},
        }
    return {
        "id": "chatcmpl-check", "object": "chat.completion", "created": 0, "model": "check",
        "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": text}}],
        "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
    }


def build_test_config(
    *, gateway_config: GatewayConfig, subscription_url: str, stand_ins: dict[str, str]
) -> tuple[GatewayConfig, list[str]]:
    providers: dict[str, dict[str, JsonValue]] = {
        "anthropic": {"keys": [], "network_config": {"base_url": subscription_url, "max_retries": 0}},
    }
    unsupported: list[str] = []
    for entry, url in stand_ins.items():
        name, _, model = entry.partition("/")
        source = gateway_config.providers.get(name)
        if source is None:
            unsupported.append(f"{entry}: provider {name!r} is not defined")
            continue
        redirected = redirect_provider(name=name, provider=source, url=url, model=model)
        if redirected is None:
            unsupported.append(f"{entry}: cannot redirect a {name!r} provider to a stand-in, so it cannot be checked")
            continue
        providers[name] = redirected
    rule = {"id": SUBSCRIPTION_RULE_ID, "name": "Claude subscription", "enabled": True, "scope": "global", "priority": 100,
            "cel_expression": "model.startsWith('claude-')", "targets": [{"provider": "anthropic", "weight": 1.0}],
            "fallbacks": list(stand_ins)}
    test_config = gateway_config.model_copy(
        update={"providers": providers, "governance": gateway_config.governance.model_copy(update={"routing_rules": [RoutingRule.model_validate(rule)]})}
    )
    return test_config, unsupported


def redirect_provider(*, name: str, provider: dict[str, JsonValue], url: str, model: str) -> dict[str, JsonValue] | None:
    """The same provider pointed at a stand-in, with a test key in place of its real credentials."""
    key: dict[str, JsonValue] = {"name": "fallback-check", "value": FALLBACK_OWN_KEY, "models": [model or "*"], "weight": 1.0}
    if name == "azure":
        return {"keys": [{**key, "azure_key_config": {"endpoint": url}}], "network_config": {"max_retries": 0}}
    if name == "github-copilot":
        return {"keys": [key], "network_config": {"base_url": url, "max_retries": 0}}
    if "custom_provider_config" in provider:
        return {**provider, "keys": [key], "network_config": {"base_url": url, "max_retries": 0}}
    return None


def send_claude_code_request(*, config: GatewayConfig, bifrost: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="bifrost-fallback-check-") as app_dir:
        Path(app_dir, "config.json").write_text(config.model_dump_json(exclude_none=True))
        port = free_port()
        admin_password = secrets.token_urlsafe(16)
        env = {**os.environ, "BIFROST_ENCRYPTION_KEY": secrets.token_urlsafe(32), "BIFROST_ADMIN_PASSWORD": admin_password,
               "BIFROST_SETUP_TOKEN": secrets.token_hex(16)}
        with subprocess.Popen([str(bifrost), "-host", "127.0.0.1", "-port", str(port), "-app-dir", app_dir, "-log-level", "error"],
                              env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) as gateway:
            try:
                base = f"http://127.0.0.1:{port}"
                wait_until_healthy(base=base)
                disable_inference_auth(base=base, admin_password=admin_password)
                post(url=f"{base}/anthropic/v1/messages", headers=CLAUDE_CODE_HEADERS,
                     body={"model": "claude-opus-5-5", "max_tokens": 16, "messages": [{"role": "user", "content": "say ok"}]})
            finally:
                gateway.terminate()


def free_port() -> int:
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def wait_until_healthy(*, base: str) -> None:
    deadline = time.monotonic() + STARTUP_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        try:
            urllib.request.urlopen(f"{base}/health", timeout=1).close()
            return
        except (urllib.error.URLError, ConnectionError):
            time.sleep(0.3)
    raise RuntimeError("the test gateway did not start")


# A fresh Bifrost database turns on "virtual key required", which would refuse the test request
# before routing; the setup script turns the same flags off on the real gateway.
def disable_inference_auth(*, base: str, admin_password: str) -> None:
    auth = {"authorization": "Basic " + base64.b64encode(f"admin:{admin_password}".encode()).decode()}
    live = ClientConfigEnvelope.model_validate_json(get(url=f"{base}/api/config", headers=auth))
    client = {**live.client_config, "enforce_auth_on_inference": False, "enforce_governance_header": False}
    retention = client.get("log_retention_days")
    client["log_retention_days"] = retention if isinstance(retention, int) and retention >= 1 else 1
    post(url=f"{base}/api/config", headers={**auth, "content-type": "application/json"}, body={"client_config": client}, method="PUT")


class ClientConfigEnvelope(BaseModel):
    model_config = ConfigDict(extra="allow")
    client_config: dict[str, JsonValue]


def get(*, url: str, headers: dict[str, str]) -> bytes:
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=REQUEST_TIMEOUT_SECONDS) as response:
        return response.read()


def post(*, url: str, headers: dict[str, str], body: dict[str, JsonValue], method: str = "POST") -> None:
    request = urllib.request.Request(url, data=JSON_BODY.dump_json(body), headers=headers, method=method)
    try:
        urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS).close()
    except urllib.error.HTTPError:
        pass  # the verdict comes from what the stand-ins received, not from the gateway's answer


JSON_BODY = TypeAdapter(dict[str, JsonValue])


def judge(*, subscription: Recording, stand_ins: dict[str, Recording]) -> list[str]:
    problems: list[str] = []
    if not subscription.requests:
        problems.append("the subscription stand-in was never called, so the fallback path was not exercised")
    for entry, recording in stand_ins.items():
        if not recording.requests:
            problems.append(f"{entry}: never reached, so it could not be checked")
        leaked = [request for request in recording.requests if carries_sign_in(headers=request)]
        if leaked:
            problems.append(f"{entry}: received the Claude sign-in in {len(leaked)} of {len(recording.requests)} request(s)")
    return problems


def carries_sign_in(*, headers: dict[str, str]) -> bool:
    return any(marker in value for value in headers.values() for marker in SIGN_IN_MARKERS)


if __name__ == "__main__":
    app()
