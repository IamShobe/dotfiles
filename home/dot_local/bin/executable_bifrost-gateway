#!/bin/bash
# Start or restart the local Bifrost gateway with the same environment the claude wrapper uses.
# usage: bifrost-gateway {up|start|restart}
set -euo pipefail

PORT="${CLAUDE_BIFROST_PORT:-4001}"
BIFROST_DIR="${HOME}/.config/bifrost"
PATTERN="bifrost -host 127.0.0.1 -port ${PORT}"
START_ATTEMPTS=60

gateway_up() { curl -sf -m 1 "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; }

start_gateway() {
  (
    set -a; . "${BIFROST_DIR}/secrets.env"; set +a
    az_bin="$(command -v az 2>/dev/null || echo "${HOME}/.local/share/mise/installs/azure-cli/latest/bin/az")"
    export BIFROST_REAL_AZ="${az_bin}"
    export PATH="${HOME}/.local/share/bifrost-az:$(dirname "${az_bin}"):${PATH}"
    mkdir -p "${HOME}/.cache/bifrost"
    nohup "${HOME}/.local/bin/bifrost" -host 127.0.0.1 -port "${PORT}" -app-dir "${BIFROST_DIR}" -log-level warn \
      >>"${HOME}/.cache/bifrost/proxy.log" 2>&1 &
  )
  for _ in $(seq 1 "${START_ATTEMPTS}"); do gateway_up && return 0; sleep 0.5; done
  echo "bifrost did not start; see ~/.cache/bifrost/proxy.log" >&2
  return 1
}

stop_gateway() {
  pkill -f "${PATTERN}" 2>/dev/null || true
  for _ in $(seq 1 "${START_ATTEMPTS}"); do pgrep -f "${PATTERN}" >/dev/null || return 0; sleep 0.2; done
}

case "${1:-}" in
  up) gateway_up ;;
  start) gateway_up || start_gateway ;;
  restart) stop_gateway; start_gateway ;;
  *) echo "usage: bifrost-gateway {up|start|restart}" >&2; exit 2 ;;
esac
