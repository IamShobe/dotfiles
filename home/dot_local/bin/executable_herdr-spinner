#!/usr/bin/env python3
"""Animate a $spin metadata token for herdr workspaces/panes with working agents.

herdr 0.8.0 replaced the animated working-state spinner with a static mark.
This daemon restores the animation through supported APIs only: it polls
`herdr api snapshot` for working agents and stamps spinner frames into their
`spin` metadata token via `herdr {workspace,pane} report-metadata`. Render it
by adding "$spin" at the END of ui.sidebar.agents.rows / ui.sidebar.spaces.rows
in ~/.config/herdr/config.toml — trailing position matters: the token clears
when the agent stops working, and only an end-of-row token can vanish without
reflowing the text before it. The native state_icon stays untouched.

Frames carry a TTL so a crash leaves no frozen glyph; the TTL is long
relative to the frame interval so a slow tick never reads as flicker.
"""

import json
import subprocess
import time

FRAMES = "⣾⣽⣻⢿⡿⣟⣯⣷"
FRAME_INTERVAL = 0.15          # seconds between frames while animating
SNAPSHOT_INTERVAL = 1.0        # how often to re-check which agents are working
DOWN_INTERVAL = 5.0            # retry cadence when the herdr server is down
TTL_MS = 5000                  # crash cleanup only; frames overwrite each other

def herdr_fire(*args: str) -> None:
    """Fire-and-forget herdr call; keeps the frame loop off the CLI's latency."""
    subprocess.Popen(
        ["herdr", *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

def working_targets() -> dict[str, set[str]] | None:
    """Working-agent targets by report-metadata scope; None if herdr is down."""
    try:
        proc = subprocess.run(
            ["herdr", "api", "snapshot"],
            capture_output=True, text=True, timeout=10,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if proc.returncode != 0:
        return None
    try:
        snapshot = json.loads(proc.stdout)["result"]["snapshot"]
    except (json.JSONDecodeError, KeyError):
        return None
    return {
        "workspace": {
            ws["workspace_id"]
            for ws in snapshot.get("workspaces", [])
            if ws.get("agent_status") == "working"
        },
        "pane": {
            agent["pane_id"]
            for agent in snapshot.get("agents", [])
            if agent.get("agent_status") == "working"
        },
    }

def set_frame(scope: str, target_id: str, frame: str) -> None:
    herdr_fire(
        scope, "report-metadata", target_id,
        "--source", "spinner",
        "--token", f"spin={frame}",
        "--ttl-ms", str(TTL_MS),
    )

def clear_frame(scope: str, target_id: str) -> None:
    herdr_fire(
        scope, "report-metadata", target_id,
        "--source", "spinner",
        "--clear-token", "spin",
    )

def main() -> None:
    frame_index = 0
    targets: dict[str, set[str]] = {"workspace": set(), "pane": set()}
    last_snapshot = 0.0
    while True:
        now = time.monotonic()
        if now - last_snapshot >= SNAPSHOT_INTERVAL:
            fresh = working_targets()
            last_snapshot = now
            if fresh is None:
                targets = {"workspace": set(), "pane": set()}
                time.sleep(DOWN_INTERVAL)
                continue
            for scope in targets:
                for target_id in targets[scope] - fresh[scope]:
                    clear_frame(scope, target_id)
            targets = fresh

        if not targets["workspace"] and not targets["pane"]:
            time.sleep(SNAPSHOT_INTERVAL)
            continue

        frame = FRAMES[frame_index % len(FRAMES)]
        frame_index += 1
        for scope in targets:
            for target_id in targets[scope]:
                set_frame(scope, target_id, frame)
        time.sleep(FRAME_INTERVAL)

if __name__ == "__main__":
    main()
