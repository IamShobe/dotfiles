#!/bin/bash
# herdr coder shim: when HERDR_CODER_WS is set (coder-backed herdr panes),
# "claude" runs remotely in the pod over SSH but keeps argv0 "claude" so
# herdr's process-based agent occupancy detection still recognizes the pane.
# The Claude OAuth token is read via `op read` (1Password CLI) and piped over
# the ssh connection's stdin, consumed by a `read` in the remote command
# before the pty hands off to claude's own stdin — the token is never written
# to disk on either end, and never appears in any process's argv.
if [[ -n "${HERDR_CODER_WS:-}" ]]; then
  # Build the remote `exec claude ...` invocation as a single safely-quoted
  # string. With zero args this must produce exactly `exec claude` — no
  # trailing empty-string argument, which claude misreads as implying
  # --print with no piped input ("Input must be provided either through
  # stdin or as a prompt argument when using --print").
  exec_claude="exec claude"
  if (( $# > 0 )); then
    exec_claude="exec claude $(printf '%q ' "$@")"
  fi
  # The interactive TUI's first-run onboarding (theme picker -> login picker)
  # ignores CLAUDE_CODE_OAUTH_TOKEN by design (upstream issue #46259, closed
  # not-planned) even though -p mode and `claude auth status` honor it. The
  # sanctioned workaround is seeding onboarding-complete state into
  # ~/.claude.json so the TUI starts straight at the prompt and then picks up
  # the env var as its credential.
  remote_cmd='
    if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
      if ! grep -q hasCompletedOnboarding "$HOME/.claude.json" 2>/dev/null; then
        [ -s "$HOME/.claude.json" ] || echo "{}" > "$HOME/.claude.json"
        v="$(claude --version 2>/dev/null | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" | head -1)"
        tmp="$(mktemp)" && jq --arg v "${v:-2.1.221}" \
          ". + {hasCompletedOnboarding: true, lastOnboardingVersion: \$v, theme: \"dark\"}" \
          "$HOME/.claude.json" > "$tmp" && mv "$tmp" "$HOME/.claude.json"
      fi
      # Skip the per-directory trust prompt for the pod'\''s one real project
      # path (undocumented internal state; see projects.<path>.hasTrustDialogAccepted).
      tmp="$(mktemp)" && jq \
        ". + {projects: ((.projects // {}) + {\"/workspace/act\": ((.projects[\"/workspace/act\"] // {}) + {hasTrustDialogAccepted: true})})}" \
        "$HOME/.claude.json" > "$tmp" && mv "$tmp" "$HOME/.claude.json"
      mkdir -p "$HOME/.claude"
      if [ ! -s "$HOME/.claude/settings.json" ]; then
        echo "{}" > "$HOME/.claude/settings.json"
      fi
      tmp="$(mktemp)" && jq \
        ". + {permissions: ((.permissions // {}) + {defaultMode: \"auto\"}), skipAutoPermissionPrompt: true}" \
        "$HOME/.claude/settings.json" > "$tmp" && mv "$tmp" "$HOME/.claude/settings.json"
    fi
    cd /workspace/act 2>/dev/null || true
    '"${exec_claude}"'
  '
  # Token delivery via SSH SendEnv: the value lives only in this process's
  # environment (from op read) and travels inside the encrypted SSH channel.
  # Never in argv on either side (only the VARIABLE NAME is in argv), never
  # in a file anywhere, and stdin stays the pane's real tty so `ssh -t`
  # allocates a proper pty for the interactive session. (Piping the token
  # over stdin instead silently downgrades -t to no-pty — the warning is
  # hidden by LogLevel ERROR — and pty-less claude dies in --print mode.)
  OP_TOKEN_REF="${HERDR_CODER_OP_REF:-op://Employee/claude-coder-oauth/credential}"
  if command -v op >/dev/null 2>&1; then
    CLAUDE_CODE_OAUTH_TOKEN="$(op read "${OP_TOKEN_REF}" 2>/dev/null)" || CLAUDE_CODE_OAUTH_TOKEN=""
    export CLAUDE_CODE_OAUTH_TOKEN
  fi
  # GH_TOKEN rides the same SendEnv channel so gh (PR status, gh pr, git
  # credential helper via gh) works inside the remote claude session without
  # a per-pod `gh auth login`.
  if command -v gh >/dev/null 2>&1; then
    GH_TOKEN="$(gh auth token 2>/dev/null)" || GH_TOKEN=""
    export GH_TOKEN
  fi
  # CODER_SSH_WAIT=no: connect as soon as the agent is up instead of blocking
  # until the pod's full startup script (k3d + pnpm + tilt) finishes.
  export CODER_SSH_WAIT=no
  exec -a claude ssh -t -o SendEnv=CLAUDE_CODE_OAUTH_TOKEN -o SendEnv=GH_TOKEN "coder.${HERDR_CODER_WS}" "$remote_cmd"
fi
# not a coder pane: fall through to the real claude (strip shim dir from PATH)
SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="$(echo "$PATH" | tr ':' '\n' | grep -vxF "$SHIM_DIR" | tr '\n' ':' )" exec claude "$@"
