#!/bin/bash
# Skills and plugins through skillshare. Its source is this repo's skills/ folder; its config
# (~/.config/skillshare/config.yaml) is managed here. Restores what skillshare installed from
# upstream (skills/.metadata.json) and its plugins, then links everything into each agent.
# Re-runs when the config or the committed install list changes.
# config: {{ include "private_dot_config/skillshare/config.yaml" | sha256sum }}
# installs: {{ output "git" "-C" .chezmoi.workingTree "rev-parse" "HEAD:skills/.metadata.json" | trim }}

set -euo pipefail

command -v skillshare >/dev/null || { echo "skillshare not installed (brew bundle installs it); skipping"; exit 0; }

# skillshare's documented restore on another machine (docs: how-to/sharing/cross-machine-sync):
# installs from .metadata.json, then skills/agents/extras/MCP/hooks, then plugins (never in --all).
skillshare install -g
skillshare sync --all -g
skillshare sync plugins --no-tui -g
