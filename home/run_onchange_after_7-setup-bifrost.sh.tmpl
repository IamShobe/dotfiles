#!/bin/bash
# Provision the local Bifrost gateway so `claude` routes through it on a fresh machine.
#
# Three things are machine-local and therefore NOT in the dotfiles repo; each one of
# them, when missing, used to need manual debugging:
#   1. the bifrost binary          -> downloaded here, pinned to BIFROST_VERSION below.
#      Bumping that line changes this script, so chezmoi reruns it on every machine:
#      each one backs up its config database, installs the new binary and restarts a
#      running gateway. Releases: https://github.com/maximhq/bifrost/releases (transports/v*)
#   2. ~/.config/bifrost/secrets.env -> generated here (random secrets, never committed)
#   3. governance enforcement flags  -> disabled here via the admin API
#
# (3) is the subtle one: Bifrost's first-run setup turns on enforce_auth_on_inference
# (maximhq/bifrost#5767), which rejects every inference request with
# "virtual key is required. Provide a virtual key via the x-bf-vk header" (HTTP 401)
# unless a virtual key exists. We route Claude Code's own OAuth through the gateway and
# define no virtual keys, so enforcement must be off.
#
# Safe to re-run: every step is skipped when already satisfied. Never fatal — the
# claude wrapper falls back to a direct run if the gateway is unavailable.
# Config template and providers.local.json hashes, so a local provider change reruns this. Discovered
# model lists are left out: bifrost-model-refresh reloads the gateway for those itself.
# template hash: {{ include "private_dot_config/bifrost/private_config.json.tmpl" | sha256sum }}
# providers hash: {{ $providers := joinPath .chezmoi.homeDir ".config/bifrost/providers.local.json" }}{{ if stat $providers }}{{ include $providers | sha256sum }}{{ end }}
# refresh hash: {{ include "dot_local/bin/executable_bifrost-model-refresh" | sha256sum }}

set -euo pipefail

BIFROST_VERSION="v2.6.0"
BIFROST_BIN="${HOME}/.local/bin/bifrost"
BIFROST_DIR="${HOME}/.config/bifrost"
SECRETS="${BIFROST_DIR}/secrets.env"
VERSION_FILE="${HOME}/.local/state/bifrost/installed-version"
PORT="${CLAUDE_BIFROST_PORT:-4001}"

gateway_up() { curl -sf -m 1 "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; }

# Start/restart with the claude wrapper's environment (az shim for Azure tokens).
start_gateway() { "${HOME}/.local/bin/bifrost-gateway" start; }
restart_gateway() { "${HOME}/.local/bin/bifrost-gateway" restart; }

# --- 1. binary ---------------------------------------------------------------
installed_version="$(cat "${VERSION_FILE}" 2>/dev/null || true)"
if [ ! -x "${BIFROST_BIN}" ] || [ "${installed_version}" != "${BIFROST_VERSION}" ]; then
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux)  os=linux ;;
    *) echo "bifrost: unsupported OS $(uname -s); skipping"; exit 0 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64)  arch=amd64 ;;
    *) echo "bifrost: unsupported arch $(uname -m); skipping"; exit 0 ;;
  esac

  echo "Installing bifrost ${BIFROST_VERSION} (${os}/${arch}, was: ${installed_version:-unknown})..."
  mkdir -p "${HOME}/.local/bin" "$(dirname "${VERSION_FILE}")"
  tmp="$(mktemp)"
  if ! curl -fL --retry 2 -o "${tmp}" \
      "https://downloads.getmaxim.ai/bifrost/${BIFROST_VERSION}/${os}/${arch}/bifrost-http"; then
    rm -f "${tmp}"
    echo "  WARNING: download failed; keeping the current binary"
    [ -x "${BIFROST_BIN}" ] || exit 0
  else
    chmod +x "${tmp}"
    # Unsigned download: clear the quarantine bit or macOS refuses to exec it.
    [ "${os}" = darwin ] && xattr -d com.apple.quarantine "${tmp}" 2>/dev/null || true
    # New versions migrate config.db in place, and some migrations cannot be undone.
    if ls "${BIFROST_DIR}"/config.db* >/dev/null 2>&1; then
      backup="${BIFROST_DIR}/backup-${installed_version:-unknown}-$(date +%Y%m%d-%H%M%S)"
      mkdir -p "${backup}"
      cp "${BIFROST_DIR}"/config.db* "${backup}/"
      [ -x "${BIFROST_BIN}" ] && cp "${BIFROST_BIN}" "${backup}/bifrost"
      echo "  backed up the config database and old binary to ${backup}"
    fi
    mv "${tmp}" "${BIFROST_BIN}"
    echo "${BIFROST_VERSION}" > "${VERSION_FILE}"
    echo "  installed ${BIFROST_BIN} (a running gateway restarts in step 3)"
  fi
fi

# --- 2. secrets --------------------------------------------------------------
# Referenced as env.* from config.json. Values are arbitrary; they only need to be
# stable and secret, so generate them once per machine.
if [ ! -f "${SECRETS}" ]; then
  echo "Generating ${SECRETS}..."
  mkdir -p "${BIFROST_DIR}"
  umask 177
  {
    echo "# Generated per-machine by chezmoi. Never commit."
    echo "export BIFROST_ENCRYPTION_KEY='$(openssl rand -base64 32)'"
    echo "export BIFROST_ADMIN_PASSWORD='$(openssl rand -base64 24)'"
    echo "export BIFROST_SETUP_TOKEN='$(openssl rand -hex 32)'"
  } > "${SECRETS}"
  echo "  admin password: see ${SECRETS}"
fi

# --- 3. fallback safety, then reload -------------------------------------------
# Some Bifrost versions forward Claude Code's sign-in to a fallback provider. Prove the
# configured fallbacks receive only their own keys; otherwise remove them before the gateway
# reads the config. Fail closed: a check that cannot run counts as a failure.
CONFIG="${BIFROST_DIR}/config.json"
if [ -f "${CONFIG}" ]; then
  if "${HOME}/.local/bin/bifrost-fallback-check" --config "${CONFIG}" --bifrost "${BIFROST_BIN}" --repair; then
    :
  else
    echo "  WARNING: unsafe fallback rules were disabled; checking the remaining routes."
    if ! "${HOME}/.local/bin/bifrost-fallback-check" --config "${CONFIG}" --bifrost "${BIFROST_BIN}"; then
      echo "  ERROR: fallback safety could not be verified. Gateway reload stopped."
      exit 1
    fi
  fi
fi

# This script reruns only when the binary or the config changed, and the gateway reads both
# only at start: restart a running one.
if gateway_up && [ -f "${SECRETS}" ]; then
  restart_gateway && echo "Restarted the running gateway (${BIFROST_VERSION})" \
    || echo "  WARNING: gateway did not restart; see ~/.cache/bifrost/proxy.log"
fi

# --- 4. governance flags -----------------------------------------------------
# These live in Bifrost's SQLite config.db, not config.json, so chezmoi cannot
# manage them declaratively — they have to be set through the running admin API.
command -v python3 >/dev/null || { echo "python3 missing; skipping governance fixup"; exit 0; }

set -a
# shellcheck disable=SC1090
. "${SECRETS}"
set +a

started_here=0
if ! gateway_up; then
  echo "Starting bifrost to apply governance settings..."
  started_here=1
  start_gateway || true
fi

if ! gateway_up; then
  echo "  WARNING: bifrost did not start; see ~/.cache/bifrost/proxy.log"
  exit 0
fi

auth="admin:${BIFROST_ADMIN_PASSWORD}"
live="$(curl -sf -m 10 -u "${auth}" "http://127.0.0.1:${PORT}/api/config" || true)"

if [ -n "${live}" ]; then
  payload="$(printf '%s' "${live}" | python3 -c '
import json, sys
cfg = json.load(sys.stdin).get("client_config", {})
# Bifrost omits these keys entirely once they are false, so absent == disabled.
if not cfg.get("enforce_auth_on_inference") and not cfg.get("enforce_governance_header"):
    sys.exit(1)  # already correct: nothing to do
cfg = dict(cfg)
cfg["enforce_auth_on_inference"] = False
cfg["enforce_governance_header"] = False
# GET reports 0 but PUT validation demands >= 1; logging is off so this is inert.
if cfg.get("log_retention_days", 0) < 1:
    cfg["log_retention_days"] = 1
json.dump({"client_config": cfg}, sys.stdout)
' 2>/dev/null)" || payload=""

  if [ -n "${payload}" ]; then
    echo "Disabling Bifrost virtual-key enforcement (we use Claude Code OAuth)..."
    printf '%s' "${payload}" | curl -sf -m 15 -X PUT -u "${auth}" \
      -H 'content-type: application/json' --data @- \
      "http://127.0.0.1:${PORT}/api/config" >/dev/null \
      && echo "  enforcement disabled" \
      || echo "  WARNING: could not update config; expect 401 on inference"
  fi
fi

if [ "${started_here}" = 1 ]; then
  pkill -f "bifrost -host 127.0.0.1 -port ${PORT}" 2>/dev/null || true
fi

# --- 5. model refresh ----------------------------------------------------------
# Discovered model lists stay fresh through bifrost-model-refresh every REFRESH_SECONDS (macOS
# launchd). It holds a lock, so overlapping runs skip; it reloads the gateway only on a change
# and only while no request is in flight. Output goes to its status file, never a growing log.
REFRESH_SECONDS=300
if [ "$(uname -s)" = Darwin ] && [ -f "${BIFROST_DIR}/providers.local.json" ]; then
  label="dev.local.bifrost-model-refresh"
  plist="${HOME}/Library/LaunchAgents/${label}.plist"
  tool_path="${HOME}/.local/bin"
  for tool in uv az gcloud chezmoi curl; do
    found="$(command -v "${tool}" 2>/dev/null || true)"
    [ -n "${found}" ] && tool_path="${tool_path}:$(dirname "${found}")"
  done
  mkdir -p "$(dirname "${plist}")"
  cat > "${plist}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${label}</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; . "\$HOME/.config/bifrost/secrets.env"; set +a; exec bifrost-model-refresh</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>${tool_path}:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>${REFRESH_SECONDS}</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
PLIST
  launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "${plist}" \
    && echo "Model refresh scheduled every ${REFRESH_SECONDS}s (status: ~/.local/state/bifrost/model-refresh-status.json)" \
    || echo "  WARNING: could not schedule bifrost-model-refresh"
fi

echo "Bifrost ready: claude-proxy status"
